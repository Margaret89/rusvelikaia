extends tmpl/_layout

block vars
	- var pageId = 'lk-callback'
	- var bgWhite = true

block body
	.lk
		.lk__title Личный кабинет

		.lk-data-list
			.lk-data-item.lk-data-item_dark
				.lk-data-item__top
					.lk-data-item__title Ваша скидка

					.lk-data-item__info
						+svg('ic-info','ic-info', '19', '19')


				.lk-data-item__sale 0%

			.lk-data-item
				.lk-data-item__top
					.lk-data-item__title Бонусные баллы

					.lk-data-item__info
						+svg('ic-info','ic-info', '19', '19')

				.lk-data-item__num-wrap
					.lk-data-item__num.lk-data-item__num_red 1 000
						+svg('ic-lightning','ic-lightning', '11', '21')

			.lk-data-item
				.lk-data-item__top
					.lk-data-item__title Номер кабинета

				.lk-data-item__num-wrap
					.lk-data-item__num 4898305
					.lk-data-item__copy
						+svg('ic-copy','ic-copy', '17', '19')

			.lk-data-item
				.lk-data-item__top
					.lk-data-item__title Сумма покупок

					.lk-data-item__info
						+svg('ic-info','ic-info', '19', '19')

				.lk-data-item__num-wrap
					.lk-data-item__num 356 789
					.lk-data-item__currency &#8381;

		.lk__content
			.lk__sidebar
				ul.lk-menu
					-
						var list=[
							{text:'Личные данные'},
							{text:'Адреса доставки'},
							{text:'Бонусная система'},
							{text:'Промокоды', count:'2'},
							{text:'Истрия заказов'},
							{text:'Избранное'},
							{text:'Обратная связь', count:'3', line:'true', status:'active'},
						]
					each item in list
						li.lk-menu__item(class=item.status?'active':'', class=item.line?'lk-menu__item_line':'')
							a(href="#").lk-menu__link= item.text
								if(item.count)
									span.lk-menu__count= item.count

				.lk__exit
					a(href="#") Выйти из ЛК

			.lk__main
				.lk__subtitle Обратная связь

				form.form-callback
					.form-callback__content
						.form-callback__item.form-callback__item_half.js-form-lk-item
							.form-callback__label Новое обращение

							.form-callback__field
								textarea(name="msg", placeholder="Текст обращения")

					.form-callback__bottom
						.file-upload.js-file-upload
							label.file-upload__content
								input(type="file", name="file")
								.file-upload__icon
									+svg('ic-clip','ic-clip', '17', '28')
								.file-upload__text.js-file-upload-text Прикрепить файл

						button(type="submit").btn Отправить

				.lk__label Мои обращения

				.unwrap-history.js-unwrap-block
					.unwrap-history__head.js-unwrap-head
						.unwrap-history__head-left.unwrap-history__head-left_static
							.unwrap-history__title Обращение №578937
							.unwrap-history__date 20 мая 2026

						.unwrap-history__head-right
							.unwrap-history__arr
								+svg('ic-arr-down','ic-arr-down', '16', '7')

					.unwrap-history__content.js-unwrap-content
						.unwrap-history__info.js-unwrap-info
							.msg-list
								-
									var list=[
										{date:'18 апреля 2026', text:'Добрый день. Заказ №9760893 должен был быть доставлен вчера. Что с доставкой?'},
										{date:'18 апреля 2026', text:'Здравствуйте, Егор. Приносим извинения, служба доставки перегружена в связи с праздниками. Для вас доставка будет бесплатной. Курьер приедет в течение часа.'},
										{date:'18 апреля 2026', text:'Понял вас, спасибо, жду.'},
									]
								each item in list
									.msg-item
										.msg-item__date= item.date
										.msg-item__text= item.text

								.msg-list__status Статус обращения: закрыто
				
				.unwrap-history.js-unwrap-block
					.unwrap-history__head.js-unwrap-head
						.unwrap-history__head-left.unwrap-history__head-left_static
							.unwrap-history__title Обращение №438790
							.unwrap-history__date 10 апреля 2026

						.unwrap-history__head-right
							.unwrap-history__arr
								+svg('ic-arr-down','ic-arr-down', '16', '7')

					.unwrap-history__content.js-unwrap-content
						.unwrap-history__info.js-unwrap-info
							.msg-list
								-
									var list=[
										{date:'18 апреля 2026', text:'Добрый день. Заказ №9760893 должен был быть доставлен вчера. Что с доставкой?'},
										{date:'18 апреля 2026', text:'Здравствуйте, Егор. Приносим извинения, служба доставки перегружена в связи с праздниками. Для вас доставка будет бесплатной. Курьер приедет в течение часа.'},
										{date:'18 апреля 2026', text:'Понял вас, спасибо, жду.'},
									]
								each item in list
									.msg-item
										.msg-item__date= item.date
										.msg-item__text= item.text

								.msg-list__status Статус обращения: закрыто
				
				.unwrap-history.js-unwrap-block
					.unwrap-history__head.js-unwrap-head
						.unwrap-history__head-left.unwrap-history__head-left_static
							.unwrap-history__title Обращение №368792
							.unwrap-history__date 03 апреля 2026

						.unwrap-history__head-right
							.unwrap-history__arr
								+svg('ic-arr-down','ic-arr-down', '16', '7')

					.unwrap-history__content.js-unwrap-content
						.unwrap-history__info.js-unwrap-info
							.msg-list
								-
									var list=[
										{date:'18 апреля 2026', text:'Добрый день. Заказ №9760893 должен был быть доставлен вчера. Что с доставкой?'},
										{date:'18 апреля 2026', text:'Здравствуйте, Егор. Приносим извинения, служба доставки перегружена в связи с праздниками. Для вас доставка будет бесплатной. Курьер приедет в течение часа.'},
										{date:'18 апреля 2026', text:'Понял вас, спасибо, жду.'},
									]
								each item in list
									.msg-item
										.msg-item__date= item.date
										.msg-item__text= item.text

								.msg-list__status Статус обращения: закрыто
				

	include ./components/_subscribe