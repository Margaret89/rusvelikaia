extends tmpl/_layout

block vars
	- var pageId = 'lk-wish'
	- var bgWhite = true

block body
	.lk
		.lk__title Личный кабинет

		.lk-data-list
			.lk-data-item.lk-data-item_dark
				.lk-data-item__top
					.lk-data-item__title Ваша скидка

					.lk-data-item__info
						+svg('ic-info','ic-info', '19', '19')


				.lk-data-item__sale 0%

			.lk-data-item
				.lk-data-item__top
					.lk-data-item__title Бонусные баллы

					.lk-data-item__info
						+svg('ic-info','ic-info', '19', '19')

				.lk-data-item__num-wrap
					.lk-data-item__num.lk-data-item__num_red 1 000
						+svg('ic-lightning','ic-lightning', '11', '21')

			.lk-data-item
				.lk-data-item__top
					.lk-data-item__title Номер кабинета

				.lk-data-item__num-wrap
					.lk-data-item__num 4898305
					.lk-data-item__copy
						+svg('ic-copy','ic-copy', '17', '19')

			.lk-data-item
				.lk-data-item__top
					.lk-data-item__title Сумма покупок

					.lk-data-item__info
						+svg('ic-info','ic-info', '19', '19')

				.lk-data-item__num-wrap
					.lk-data-item__num 356 789
					.lk-data-item__currency &#8381;

		.lk__content
			.lk__sidebar
				ul.lk-menu
					-
						var list=[
							{text:'Личные данные'},
							{text:'Адреса доставки'},
							{text:'Бонусная система'},
							{text:'Промокоды', count:'2'},
							{text:'Истрия заказов'},
							{text:'Избранное', status:'active'},
							{text:'Обратная связь', count:'3', line:'true'},
						]
					each item in list
						li.lk-menu__item(class=item.status?'active':'', class=item.line?'lk-menu__item_line':'')
							a(href="#").lk-menu__link= item.text
								if(item.count)
									span.lk-menu__count= item.count

				.lk__exit
					a(href="#") Выйти из ЛК

			.lk__main
				.lk__subtitle Избранное

				.catalog-list
					-
						var list=[
							{img:'product-tree.png', prop:'Высота 30 мм', price:'11 660', title:'Декоративная тарелка «Зима. Утенок». Форма Эллипс. ИФЗ', article:'Артикул: 0074240'},
							{img:'product-box.png', prop:'Высота 30 мм', price:'3 600', title:'Тарелка декоративная «Красный конь». Форма Эллипс. ИФЗ', article:'Артикул: 400147'},
							{img:'product-horse.png', prop:'Высота 30 мм', price:'11 660', title:'Декоративная тарелка «Зима. Мальчик». Форма Эллипс. ИФЗ', article:'Артикул: 400150'},
							{img:'product-horse2.png', prop:'Диаметр 275 мм', price:'4 200', title:'Тарелка декоративная «Маленький Принц. Цитаты» ЛФЗ', article:'Артикул: 712024310'},
							{img:'product-tree.png', prop:'Высота 30 мм', price:'11 660', title:'Декоративная тарелка «Зима. Утенок». Форма Эллипс. ИФЗ', article:'Артикул: 0074240'},
							{img:'product-box.png', prop:'Высота 30 мм', price:'3 600', title:'Тарелка декоративная «Красный конь». Форма Эллипс. ИФЗ', article:'Артикул: 400147'},
							{img:'product-horse.png', prop:'Высота 30 мм', price:'11 660', title:'Декоративная тарелка «Зима. Мальчик». Форма Эллипс. ИФЗ', article:'Артикул: 400150'},
							{img:'product-horse2.png', prop:'Диаметр 275 мм', price:'4 200', title:'Тарелка декоративная «Маленький Принц. Цитаты» ЛФЗ', article:'Артикул: 712024310'},
						]
					each item in list
						.catalog-item
							.catalog-item__top
								.catalog-item__prop= item.prop
								.catalog-item__price= item.price
									| 
									|&#8381;

							a(href="#").catalog-item__img-wrap
								.catalog-item__img
									img(src="/upload/"+item.img, alt="")
								
							.catalog-item__title
								a(href="#")= item.title

							.catalog-item__article= item.article

	include ./components/_subscribe