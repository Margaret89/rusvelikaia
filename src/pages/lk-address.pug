extends tmpl/_layout

block vars
	- var pageId = 'lk-address'
	- var bgWhite = true

block body
	.lk
		.lk__title Личный кабинет

		.lk-data-list
			.lk-data-item.lk-data-item_dark
				.lk-data-item__top
					.lk-data-item__title Ваша скидка

					.lk-data-item__info
						+svg('ic-info','ic-info', '19', '19')


				.lk-data-item__sale 0%

			.lk-data-item
				.lk-data-item__top
					.lk-data-item__title Бонусные баллы

					.lk-data-item__info
						+svg('ic-info','ic-info', '19', '19')

				.lk-data-item__num-wrap
					.lk-data-item__num.lk-data-item__num_red 1 000
						+svg('ic-lightning','ic-lightning', '11', '21')

			.lk-data-item
				.lk-data-item__top
					.lk-data-item__title Номер кабинета

				.lk-data-item__num-wrap
					.lk-data-item__num 4898305
					.lk-data-item__copy
						+svg('ic-copy','ic-copy', '17', '19')

			.lk-data-item
				.lk-data-item__top
					.lk-data-item__title Сумма покупок

					.lk-data-item__info
						+svg('ic-info','ic-info', '19', '19')

				.lk-data-item__num-wrap
					.lk-data-item__num 356 789
					.lk-data-item__currency &#8381;

		.lk__content
			.lk__sidebar
				ul.lk-menu
					-
						var list=[
							{text:'Личные данные'},
							{text:'Адреса доставки', status:'active'},
							{text:'Бонусная система'},
							{text:'Промокоды', count:'2'},
							{text:'Истрия заказов'},
							{text:'Избранное'},
							{text:'Обратная связь', count:'3', line:'true'},
						]
					each item in list
						li.lk-menu__item(class=item.status?'active':'', class=item.line?'lk-menu__item_line':'')
							a(href="#").lk-menu__link= item.text
								if(item.count)
									span.lk-menu__count= item.count

				.lk__exit
					a(href="#") Выйти из ЛК

			.lk__main
				.lk__subtitle Адреса доставки

				.address-list
					.address-list__title Сохраненные адреса

					-
						var list=[
							{title:'Дом', text:'г. Москва, ул. Бакинская, д. 46 к2'},
							{title:'Офис', text:'г. Москва, ул. Шереметьевская, 6 корп. 1'},
						]
					each item in list
						.address-item
							.address-item__main
								.address-item__icon
									+svg('ic-map','ic-map', '35', '35')

								.address-item__content
									.address-item__title= item.title
									.address-item__text= item.text

							.address-item__actions
								.address-item__change Изменить

								.address-item__del
									+svg('ic-close','ic-close', '17', '17')

				.delivery-form
					.delivery-form__title Укажите новый адрес доставки

					.delivery-form__list
						label.delivery-form__item
							input(name="address", type="text", placeholder=" ", value="Москва")
							.delivery-form__label Местоположение

						label.delivery-form__item
							input(name="street", type="text", placeholder=" ")
							.delivery-form__label Улица и номер дома

						.delivery-form__group
							label.delivery-form__item
								input(name="ofice", type="text", placeholder=" ", value="248")
								.delivery-form__label Кв/Офис

							label.delivery-form__item
								input(name="entrance", type="text", placeholder=" ", value="2")
								.delivery-form__label Подъезд

							label.delivery-form__item
								input(name="floor", type="text", placeholder=" ", value="10")
								.delivery-form__label Этаж

							label.delivery-form__item
								input(name="doorphone", type="text", placeholder=" ", value="248")
								.delivery-form__label Домофон

						label.delivery-form__item
							input(name="comment", type="text", placeholder=" ")
							.delivery-form__label Название для сохранения адреса

						.delivery-form__btn
							button(type="submit").btn
								span.hide-mobile Сохранить изменения
								span.hide-desktop Сохранить
									
	include ./components/_subscribe