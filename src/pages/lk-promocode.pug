extends tmpl/_layout

block vars
	- var pageId = 'lk-promocode'
	- var bgWhite = true

block body
	.lk
		.lk__title Личный кабинет

		.lk-data-list
			.lk-data-item.lk-data-item_dark
				.lk-data-item__top
					.lk-data-item__title Ваша скидка

					.lk-data-item__info
						+svg('ic-info','ic-info', '19', '19')


				.lk-data-item__sale 5%

			.lk-data-item
				.lk-data-item__top
					.lk-data-item__title Бонусные баллы

					.lk-data-item__info
						+svg('ic-info','ic-info', '19', '19')

				.lk-data-item__num-wrap
					.lk-data-item__num.lk-data-item__num_red 1 000
						+svg('ic-lightning','ic-lightning', '11', '21')

			.lk-data-item
				.lk-data-item__top
					.lk-data-item__title Номер кабинета

				.lk-data-item__num-wrap
					.lk-data-item__num 4898305
					.lk-data-item__copy
						+svg('ic-copy','ic-copy', '17', '19')

			.lk-data-item
				.lk-data-item__top
					.lk-data-item__title Сумма покупок

					.lk-data-item__info
						+svg('ic-info','ic-info', '19', '19')

				.lk-data-item__num-wrap
					.lk-data-item__num 356 789
					.lk-data-item__currency &#8381;

		.lk__content
			.lk__sidebar
				ul.lk-menu
					-
						var list=[
							{text:'Личные данные'},
							{text:'Адреса доставки'},
							{text:'Бонусная система'},
							{text:'Промокоды', count:'2', status:'active'},
							{text:'Истрия заказов'},
							{text:'Избранное'},
							{text:'Обратная связь', count:'3', line:'true'},
						]
					each item in list
						li.lk-menu__item(class=item.status?'active':'', class=item.line?'lk-menu__item_line':'')
							a(href="#").lk-menu__link= item.text
								if(item.count)
									span.lk-menu__count= item.count

				.lk__exit
					a(href="#") Выйти из ЛК

			.lk__main
				.lk__subtitle Промокоды

				.promocode-list
					-
						var list=[
							{img:'promocode1.jpg', title:'Скидка 1000 р. на весь ассортимент «Императорского фарфора»', link:'В раздел «Императорский фарфор»'},
							{img:'promocode2.png', title:'Скидка 2000 р. на весь ассортимент изделий из янтаря', link:'В раздел «Изделия из янтаря»'},
							{img:'promocode3.jpg', title:'Скидка 1000 р. на весь ассортиментзавода «Северная чернь»', link:'В раздел «Северная чернь»'},
						]
					each item in list
						.promocode-item
							.promocode-item__content
								.promocode-item__title= item.title
								.promocode-item__text Действует до 31 июля 2026

								.promocode-field.js-promocode-field
									.promocode-field__val 50RUS39HDT589

									.promocode-field__label Открыть промокод

								.promocode-item__link
									a(href="#")= item.link

							.promocode-item__img-wrap
								.promocode-item__img
									img(src="/upload/"+item.img, alt="")

	include ./components/_subscribe